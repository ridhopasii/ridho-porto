generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Minimal model to allow prisma client generation.
model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  full_name String?
  createdAt DateTime @default(now())
}
