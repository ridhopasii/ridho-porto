# ============================================================
# ENVIRONMENT VARIABLES — ridhorobbipasi.my.id
# Salin file ini ke .env.local dan isi nilai-nilainya
# cp .env.example .env.local
# ============================================================

# --- SITE CONFIGURATION ---
DOMAIN=https://ridhorobbipasi.my.id
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# --- SUPABASE ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- NEXTAUTH ---
NEXTAUTH_SECRET=your-super-secret-random-string-min-32-chars
NEXTAUTH_URL=http://localhost:3000

# --- OAUTH PROVIDERS ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret

# --- GEMINI AI ---
GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# --- INSTAGRAM ---
INSTAGRAM_TOKEN=your-instagram-long-lived-token
VITE_INSTAGRAM_TOKEN=your-instagram-long-lived-token

# --- WHATSAPP ---
WHATSAPP_VERIFY_TOKEN=your-whatsapp-verify-token
WHATSAPP_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_ID=your-whatsapp-phone-number-id

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- ADMIN ---
ADMIN_PASSWORD=your-admin-password
PRIVATE_DASHBOARD_PASSWORD=your-private-dashboard-password

# --- JWT ---
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

# --- SESSION ---
SESSION_SECRET=your-session-secret

# --- EMAIL (Nodemailer) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# --- DATABASE ---
DATABASE_URL=file:./prisma/dev.db

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_CONTACT_MAX=3

# --- FILE UPLOAD ---
MAX_FILE_SIZE=5242880
UPLOAD_DIR=public/uploads

# --- CACHE ---
CACHE_ENABLED=true
CACHE_TTL=600

# --- SECURITY ---
HELMET_ENABLED=true
CORS_ORIGIN=http://localhost:3000

# --- LOGGING ---
LOG_LEVEL=info
